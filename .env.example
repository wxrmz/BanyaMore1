YCLIENTS_API_KEY=
# Optional alias for the partner token. If set, it is used instead of YCLIENTS_API_KEY.
YCLIENTS_PARTNER_TOKEN=
# User token for admin operations. In YCLIENTS it needs access to view/edit
# records, view financial operations, and view the daily cash report.
YCLIENTS_USER_TOKEN=
YCLIENTS_COMPANY_ID=1300176
# From this business date, kitchen services moved to a standalone record are
# removed only from the terminal subtotal shown in brackets.
YCLIENTS_KITCHEN_TERMINAL_ADJUSTMENT_FROM=2026-08-23
YCLIENTS_TERMINAL_EXCLUSION_TRANSACTION_IDS=1635573912
YCLIENTS_SURRENDERED_ADJUSTMENTS=2026-08-03:-20
YCLIENTS_BOOKING_URL=https://n1437834.yclients.com/

