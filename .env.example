YCLIENTS_API_KEY=
# Optional alias for the partner token. If set, it is used instead of YCLIENTS_API_KEY.
YCLIENTS_PARTNER_TOKEN=
# User token for the read-only report panel. It needs access to records,
# financial operations, goods, storages, stock balances and consumables.
YCLIENTS_USER_TOKEN=
YCLIENTS_COMPANY_ID=1300176
YCLIENTS_BOOKING_URL=https://n1437834.yclients.com/

ADMIN_ADMIN_LOGIN=
ADMIN_ADMIN_PASSWORD=
ADMIN_OWNER_LOGIN=
ADMIN_OWNER_PASSWORD=
ADMIN_DIRECTOR_LOGIN=
ADMIN_DIRECTOR_PASSWORD=
# Учётная запись, которой видны только тексты занятости бань для копирования.
ADMIN_COPY_LOGIN=
ADMIN_COPY_PASSWORD=
# Optional additional accounts. Example:
# ADMIN_USERS_JSON=[{"login":"manager","password":"change-me","role":"admin"}]
ADMIN_USERS_JSON=
ADMIN_SESSION_SECRET=
# Optional canonical HTTPS origin when a reverse proxy replaces the Host header.
# Example: https://admin.example.com
ADMIN_PUBLIC_ORIGIN=

# Optional overrides. Company 1300176 already has its verified article, account,
# service, goods and internal-transfer IDs in lib/yclientsFinanceConfig.ts.
# Fill these only if the YCLIENTS directory changes later.
# Exact YCLIENTS expense IDs that represent internal transfers and must not affect reports.
YCLIENTS_INTERNAL_TRANSFER_EXPENSE_IDS=

# Optional exact finance mapping overrides by YCLIENTS article ID.
# The value for each ID is a row key from the monthly/yearly statement.
# Example: {"101":"revenue.small_bath","202":"fixed.admin_salary"}
# Do not map generic YCLIENTS articles 5 (services) or 7 (goods) here.
YCLIENTS_FINANCE_ARTICLE_MAP_JSON=

# Optional strict cash/cashless override by stable YCLIENTS account ID.
# ID mappings take precedence over account titles and the is_cash flag.
# Example: {"10":"cash","11":"cashless"}
YCLIENTS_FINANCE_ACCOUNT_MAP_JSON=

# Optional sold-service and sold-good ID overrides used to split generic revenue articles.
# For goods, configure the catalog good ID, not the transient goods_transaction line ID.
# Prefer typed keys; a plain numeric key is used only when it is unambiguous.
# Example: {"service:20671398":"revenue.small_bath","good:501":"revenue.drinks"}
YCLIENTS_FINANCE_SOLD_ITEM_MAP_JSON=

# Optional: override exact YCLIENTS service/staff pairs for the bath calendar.
# Defaults are configured for company 1300176.
# YCLIENTS_SMALL_BATH_SERVICE_ID=20671398
# YCLIENTS_SMALL_BATH_STAFF_ID=3872281
# YCLIENTS_SMALL_BATH_DURATION_MINUTES=120
# YCLIENTS_BIG_BATH_1_SERVICE_ID=20671209
# YCLIENTS_BIG_BATH_1_STAFF_ID=3873893
# YCLIENTS_BIG_BATH_1_DURATION_MINUTES=120
# YCLIENTS_BIG_BATH_2_SERVICE_ID=20671305
# YCLIENTS_BIG_BATH_2_STAFF_ID=3873916
# YCLIENTS_BIG_BATH_2_DURATION_MINUTES=120
